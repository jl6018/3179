{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom 1 Example: Antique counts by decade mapped alongside an average age line overlay.",
  "width": "container",
  "height": 400,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "./data/antiques_master_data.csv"
  },
  "layer": [
    {
      "description": "Primary Metric Channel: Volume Columns split across timeline decades",
      "mark": {
        "type": "bar",
        "color": "#64748b",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },
      "encoding": {
        "x": {
          "field": "Decade",
          "type": "nominal",
          "axis": {
            "title": "Production Decade",
            "labelAngle": 0,
            "labelFont": "DM Sans, sans-serif",
            "titleFont": "DM Sans, sans-serif"
          }
        },
        "y": {
          "field": "Object_Count",
          "type": "quantitative",
          "aggregate": "sum",
          "axis": {
            "title": "Total Registered Artifacts",
            "labelFont": "DM Sans, sans-serif",
            "titleFont": "DM Sans, sans-serif"
          }
        },
        "tooltip": [
          {"field": "Decade", "type": "nominal", "title": "Decade Era"},
          {"field": "Object_Count", "type": "quantitative", "aggregate": "sum", "title": "Total Inventory Vol.", "format": ","}
        ]
      }
    },
    {
      "description": "Secondary Metric Channel: Dynamic Average Age trajectory curve tracking overall change over time",
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "point": {"color": "#ec4899", "size": 50}
      },
      "encoding": {
        "x": {
          "field": "Decade", 
          "type": "nominal"
        },
        "y": {
          "field": "Avg_Age",
          "type": "quantitative",
          "aggregate": "mean",
          "axis": {
            "title": "Mean Age of Objects (Years)",
            "orient": "right",
            "grid": false,
            "labelFont": "DM Sans, sans-serif",
            "titleFont": "DM Sans, sans-serif"
          }
        },
        "color": {"value": "#ec4899"},
        "tooltip": [
          {"field": "Decade", "type": "nominal", "title": "Decade Era"},
          {"field": "Avg_Age", "type": "quantitative", "aggregate": "mean", "title": "Calculated Mean Age", "format": ".1f"}
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}
