{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "padding": { "right": 120 },
  "config": { 
    "view": { "stroke": null }, 
    "axis": { "domain": true, "grid": false } 
  },
  "data": { "url": "./data/historical_style_transformation.csv" },
  "transform": [
    { 
      "window": [{ "op": "rank", "as": "Rank" }], 
      "groupby": ["Style_Era"], 
      "sort": [{ "field": "Object_Count", "order": "descending" }] 
    }
  ],
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 2.5 },
      "encoding": {
        "x": { 
          "field": "Style_Era", 
          "type": "ordinal", 
          "sort": ["Early Colonial","Victorian & Gold Rush","Federation & Late Colonial","Interwar & Modern"], 
          "axis": { "title": "Style Era", "labelAngle": 15 } 
        },
        "y": { 
          "field": "Rank", 
          "type": "quantitative", 
          "axis": { "title": "Rank (1 = highest volume)", "tickMinStep": 1 } 
        },
        "color": { 
          "field": "Artifact_Category", 
          "type": "nominal", 
          "scale": { 
            "domain": ["Ceramics & Pottery", "Furniture", "Horology & Clocks", "Household Utilities"], 
            "range": ["#4e79a7", "#f28e2b", "#9c27b0", "#76b7b2"] 
          }, 
          "legend": null 
        }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 80 },
      "encoding": {
        "x": { 
          "field": "Style_Era", 
          "type": "ordinal", 
          "sort": ["Early Colonial","Victorian & Gold Rush","Federation & Late Colonial","Interwar & Modern"] 
        },
        "y": { 
          "field": "Rank", 
          "type": "quantitative" 
        },
        "color": { 
          "field": "Artifact_Category", 
          "type": "nominal", 
          "scale": { 
            "domain": ["Ceramics & Pottery", "Furniture", "Horology & Clocks", "Household Utilities"], 
            "range": ["#4e79a7", "#f28e2b", "#9c27b0", "#76b7b2"] 
          }, 
          "legend": null 
        },
        "tooltip": [
          { "field": "Style_Era", "type": "nominal", "title": "Era" },
          { "field": "Artifact_Category", "type": "nominal", "title": "Category" },
          { "field": "Rank", "type": "quantitative", "title": "Rank" }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 8, "fontSize": 11, "fontWeight": "bold" },
      "transform": [{ "filter": "datum.Style_Era === 'Interwar & Modern'" }],
      "encoding": {
        "x": { 
          "field": "Style_Era", 
          "type": "ordinal", 
          "sort": ["Early Colonial","Victorian & Gold Rush","Federation & Late Colonial","Interwar & Modern"] 
        },
        "y": { 
          "field": "Rank", 
          "type": "quantitative" 
        },
        "text": { 
          "field": "Artifact_Category", 
          "type": "nominal" 
        },
        "color": { 
          "field": "Artifact_Category", 
          "type": "nominal", 
          "scale": { 
            "domain": ["Ceramics & Pottery", "Furniture", "Horology & Clocks", "Household Utilities"], 
            "range": ["#4e79a7", "#f28e2b", "#9c27b0", "#76b7b2"] 
          }, 
          "legend": null 
        }
      }
    }
  ]
}
