  },
  "transform": [
    { "calculate": "ceil(datum.Total_Museum_Objects / 5000)", "as": "Dot_Count" },
    { "calculate": "sequence(1, datum.Dot_Count + 1)", "as": "seq" },
    { "flatten": ["seq"] },
    { "calculate": "datum.Longitude + (random() - 0.5) * 2.5", "as": "Jittered_Lon" },
    { "calculate": "datum.Latitude + (random() - 0.5) * 2", "as": "Jittered_Lat" }
  ],
  "projection": { "type": "mercator", "center": [134, -28], "scale": 450 },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": { "type": "geoshape", "fill": "#f4f4f4", "stroke": "#d0d0d0", "strokeWidth": 1 }
    },
    {
      "params": [
        {
          "name": "selectState",
          "select": { "type": "point", "fields": ["State"] },
          "bind": "legend"
        }
      ],
      "mark": { "type": "circle", "size": 15, "opacity": 0.8 },
      "encoding": {
        "longitude": { "field": "Jittered_Lon", "type": "quantitative" },
        "latitude": { "field": "Jittered_Lat", "type": "quantitative" },
        "color": {
          "field": "State", "type": "nominal",
          "scale": {
            "domain": ["New South Wales", "Victoria", "Queensland", "Western Australia", "South Australia", "Tasmania", "Northern Territory", "Australian Capital Territory"],
            "range": ["#1f77b4", "#ff7f0e", "#9467bd", "#8c564b", "#e377c2", "#17becf", "#bcbd22", "#7f7f7f"]
          },
          "legend": { "title": "State Region", "orient": "right" }
        },
        "opacity": {
          "condition": { "param": "selectState", "value": 1 },
          "value": 0.2
        },
        "tooltip": [ 
          { "field": "Location_Name", "type": "nominal", "title": "Nearest Town" },
          { "field": "State", "type": "nominal", "title": "State" },
          { "field": "Total_Museum_Objects", "type": "quantitative", "title": "Total Objects", "format": "," }
        ]
      }
    },
    {
      "data": { "values": [{ "x": 1, "y": 1 }] },
      "mark": { "type": "text", "align": "center", "baseline": "top", "dx": 0, "dy": -20, "fontSize": 14, "fontWeight": "bold", "color": "#333333", "stroke": "white", "strokeWidth": 3 },
      "encoding": {
        "x": { "datum": 0, "type": "quantitative" },
        "y": { "datum": 0, "type": "quantitative" },
        "text": { "value": "● 1 Dot = 5,000 Museum Objects" }
      }
    },
    {
      "data": { "values": [{ "x": 1, "y": 1 }] },
      "mark": { "type": "text", "align": "center", "baseline": "top", "dx": 0, "dy": -20, "fontSize": 14, "fontWeight": "bold", "color": "#333333" },
      "encoding": {
        "x": { "datum": 0, "type": "quantitative" },
        "y": { "datum": 0, "type": "quantitative" },
        "text": { "value": "● 1 Dot = 5,000 Museum Objects" }
      }
    }
  ]
}
