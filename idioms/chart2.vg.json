{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "view": { "stroke": null },
    "axis": { "domain": true, "grid": true, "gridColor": "#e0e5dd" }
  },
  "data": { "url": "./data/abs_demographics_antiques.csv" },
  "layer": [
    {
      "params": [
        {
          "name": "selectSex",
          "select": { 
            "type": "point", 
            "fields": ["Sex"],
            "on": "click", 
            "clear": "dblclick" 
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": { "size": 60 },
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Age_Group", "type": "ordinal",
          "sort": ["15-17 years","18-24 years","25-34 years","35-44 years","45-54 years","55-64 years","65-74 years","75 years and over"],
          "axis": { "title": "Age Group", "labelAngle": 45 }
        },
        "y": {
          "field": "Thousands_Of_People", "type": "quantitative", "aggregate": "sum",
          "axis": { "title": "Thousands of people (total)" }
        },
        "color": {
          "field": "Sex", "type": "nominal",
          "scale": { 
            "domain": ["Males","Females"], 
            "range": ["#2C7A7B", "#DD6B20"] 
          },
          "legend": { "title": "Sex", "orient": "right" }
        },
        "opacity": {
          "condition": { "param": "selectSex", "value": 1 },
          "value": 0.2
        },
        "tooltip": [
          { "field": "Age_Group", "type": "ordinal" },
          { "field": "Sex", "type": "nominal" },
          { "field": "Thousands_Of_People", "aggregate": "sum", "type": "quantitative" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#65736d", "strokeDash": [4,3], "strokeWidth": 1 },
      "encoding": {
        "y": { "datum": 280, "type": "quantitative" },
        "tooltip": { "value": "Reference: 280,000 people" }
      }
    },
    {
      "mark": { 
        "type": "text", 
        "color": "#65736d", 
        "fontSize": 11, 
        "fontWeight": "bold",
        "dy": -8,
        "align": "left" 
      },
      "encoding": {
        "x": { "datum": "15-17 years" },
        "y": { "datum": 280, "type": "quantitative" },
        "text": { "value": "280,000 people" }
      }
    }
  ]
}
