{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom 4: Stacked Bar Chart showing origins of antiques across Australian states.",
  "width": "container",
  "height": 480,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {"url": "./data/antiques_master_data.csv"},
  "title": { "font": "DM Sans, sans-serif", "fontSize": 16, "fontWeight": "bold" },
  "mark": {"type": "bar"},
  "encoding": {
    "x": {
      "field": "State_Location",
      "type": "nominal",
      "title": "Australian State / Territory",
      "axis": {"labelAngle": 0, "labelFont": "DM Sans, sans-serif"}
    },
    "y": {
      "field": "Object_Count",
      "type": "quantitative",
      "aggregate": "sum",
      "title": "Number of Objects Recorded"
    },
    "color": {
      "field": "Origin",
      "type": "nominal",
      "scale": {
        "domain": ["Australia", "Britain", "Europe", "Asia"],
        "range": ["#14532d", "#22c55e", "#15803d", "#86efac"]
      },
      "legend": {"title": "Object Origin", "orient": "top"}
    },
    "tooltip": [
      {"field": "State_Location", "type": "nominal", "title": "State"},
      {"field": "Origin", "type": "nominal", "title": "Origin"},
      {"field": "Object_Count", "type": "quantitative", "aggregate": "sum", "title": "Items", "format": ","}
    ]
  }
}
