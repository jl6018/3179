{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "config": { 
    "view": { "stroke": null } 
  },
  "data": { "url": "./data/antiques_master_data.csv" },
  "params": [
    {
      "name": "selectCategory",
      "select": { 
        "type": "point", 
        "fields": ["Category"],
        "on": "click",
        "clear": "dblclick"
      },
      "bind": "legend"
    }
  ],
  "mark": { 
    "type": "arc", 
    "innerRadius": 90, 
    "outerRadius": 160,
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "cursor": "pointer"
  },
  "encoding": {
    "theta": { "field": "Object_Count", "type": "quantitative", "aggregate": "sum" },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": ["Ceramics", "Clocks", "Furniture", "Jewellery", "Metalware", "Textiles"],
        "range": ["#4A6B8C", "#D98C4A", "#7B8F6B", "#C2A154", "#8C5E7A", "#A0A5A9"]
      },
      "legend": { 
        "title": "Category", 
        "orient": "right" 
      }
    },
    "opacity": {
      "condition": { "param": "selectCategory", "value": 1 },
      "value": 0.3
    },
    "outerRadius": {
      "condition": { "param": "selectCategory", "value": 165 },
      "value": 160
    },
    "tooltip": [
      { "field": "Category", "type": "nominal", "title": "Category" },
      { "field": "Object_Count", "aggregate": "sum", "type": "quantitative", "title": "Count", "format": "," }
    ]
  }
}
