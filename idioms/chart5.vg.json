{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "config": { 
    "view": { "stroke": "#e0e5dd" },
    "axis": { "domain": true, "grid": true, "gridColor": "#e0e5dd" } 
  },
  "data": { "url": "./data/abs_cultural_data.csv" },
  "transform": [{ "fold": ["Attendance_Rate_Percent"], "as": ["Dummy", "Rate"] }],
  "layer": [
    {
      "transform": [{ "pivot": "Category", "value": "Attendance_Rate_Percent", "groupby": ["State"] }],
      "mark": { "type": "rule", "color": "#94a3b8", "strokeWidth": 3 },
      "encoding": {
        "y": { "field": "State", "type": "nominal", "sort": "-x", "axis": { "title": null } },
        "x": { "field": "Crafts", "type": "quantitative", "axis": { "title": "Attendance Rate (%)" } },
        "x2": { "field": "Visual Arts" },
        "opacity": {
          "condition": { "param": "selectState", "value": 1 },
          "value": 0.2
        }
      }
    },
    {
      "params": [
        {
          "name": "selectState",
          "select": { 
            "type": "point", 
            "fields": ["State"],
            "on": "click", 
            "clear": "dblclick" 
          }
        }
      ],
      "transform": [{ "pivot": "Category", "value": "Attendance_Rate_Percent", "groupby": ["State"] }, { "fold": ["Visual Arts", "Crafts"], "as": ["Category", "Rate"] }],
      "mark": { "type": "point", "filled": true, "size": 120, "stroke": "white", "strokeWidth": 1.5, "cursor": "pointer" },
      "encoding": {
        "y": { "field": "State", "type": "nominal" },
        "x": { "field": "Rate", "type": "quantitative" },
        "color": { 
          "field": "Category", 
          "type": "nominal", 
          "scale": { "domain": ["Visual Arts", "Crafts"], "range": ["#4e79a7", "#e15759"] }, 
          "legend": { "title": "Category", "orient": "right" } 
        },
        "opacity": {
          "condition": { "param": "selectState", "value": 1 },
          "value": 0.2
        },
        "tooltip": [
          { "field": "State", "type": "nominal" },
          { "field": "Category", "type": "nominal" },
          { "field": "Rate", "type": "quantitative", "format": ".1f" }
        ]
      }
    }
  ]
}
