{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "view": { "stroke": null }
  },
  "data": { 
    "url": "./data/museum_objects_by_town.csv" 
  },
  "projection": { 
    "type": "mercator", 
    "center": [134, -28], 
    "scale": 500 
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": { 
        "type": "geoshape", 
        "fill": "#f4f4f4", 
        "stroke": "#d0d0d0", 
        "strokeWidth": 1 
      }
    },
    {
      "params": [
        {
          "name": "selectTown",
          "select": { 
            "type": "point", 
            "fields": ["Location_Name"],
            "on": "click", 
            "clear": "dblclick" 
          }
        }
      ],
      "mark": { 
        "type": "circle", 
        "color": "#facc15", 
        "opacity": 0.85, 
        "stroke": "#333333", 
        "strokeWidth": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "size": {
          "field": "Total_Museum_Objects", 
          "type": "quantitative",
          "scale": { "range": [50, 1500] },
          "legend": { 
            "title": "Total Objects", 
            "orient": "right", 
            "direction": "vertical",
            "symbolType": "circle"
          }
        },
        "opacity": {
          "condition": { "param": "selectTown", "value": 1 },
          "value": 0.4
        },
        "tooltip": [
          { "field": "Location_Name", "type": "nominal", "title": "City/Town" },
          { "field": "State", "type": "nominal", "title": "State" },
          { "field": "Total_Museum_Objects", "type": "quantitative", "title": "Total Objects", "format": "," }
        ]
      }
    },
    {
      "transform": [
        { "filter": "datum.Total_Museum_Objects > 60000" }
      ],
      "mark": { 
        "type": "text", 
        "align": "left", 
        "dx": 10, 
        "dy": -5,
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "text": { "field": "Location_Name", "type": "nominal" }
      }
    }
  ]
}
