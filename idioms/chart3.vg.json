{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "config": { 
    "view": { "stroke": null },
    "axis": { "domain": true, "grid": false } 
  },
  "data": { "url": "./data/antiques_master_data.csv" },
  "params": [
    {
      "name": "highlightDecade",
      "select": { "type": "point", "on": "click", "clear": "dblclick" }
    }
  ],
  "mark": { 
    "type": "bar", 
    "cornerRadiusTopRight": 4, 
    "cornerRadiusBottomRight": 4,
    "cursor": "pointer"
  },
  "encoding": {
    "y": { 
      "field": "Decade", 
      "type": "nominal", 
      "sort": "-x",
      "axis": { "title": "Production Decade", "labelAngle": 0 } 
    },
    "x": { 
      "field": "Object_Count", 
      "type": "quantitative", 
      "aggregate": "sum", 
      "axis": { "title": "Total Registered Artifacts" } 
    },
    "color": {
      "condition": {
        "param": "highlightDecade",
        "empty": false,
        "value": "#254c3e"
      },
      "value": "#a0b4a9"
    },
    "opacity": {
      "condition": { "param": "highlightDecade", "value": 1 },
      "value": 0.8
    },
    "tooltip": [
      { "field": "Decade", "type": "nominal", "title": "Decade" },
      { "field": "Object_Count", "type": "quantitative", "aggregate": "sum", "title": "Artifacts", "format": "," }
    ]
  }
}
