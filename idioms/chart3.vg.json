{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped Bars showing absolute visitor metrics by Gender",
  "width": "container",
  "height": 480,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {"url": "./data/abs_demographics_antiques.csv"},
  "mark": {
    "type": "bar", 
    "cornerRadiusTopLeft": 4, 
    "cornerRadiusTopRight": 4
  },
  "encoding": {
    "x": {
      "field": "Age_Group",
      "type": "nominal",
      "axis": {"title": "Age Cohort", "labelAngle": -15}
    },
    "y": {
      "field": "Thousands_Of_People",
      "type": "quantitative",
      "axis": {"title": "Gender Attendance Count ('000)", "titleColor": "#254c3e"}
    },
    "xOffset": {"field": "Sex"},
    "color": {
      "field": "Sex",
      "type": "nominal",
      "scale": {"range": ["#254c3e", "#d9b47b"]},
      "legend": {"title": "Gender", "orient": "top"}
    },
    "tooltip": [
      {"field": "Age_Group", "type": "nominal", "title": "Age"},
      {"field": "Sex", "type": "nominal", "title": "Gender"},
      {"field": "Thousands_Of_People", "type": "quantitative", "title": "Visitors ('000)"}
    ]
  }
}
