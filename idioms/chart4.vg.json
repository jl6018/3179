{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": null,
  "width": "container",
  "height": 400,
  "autosize": { "type": "fit", "contains": "padding" },
  "config": { 
    "view": { "stroke": null } 
  },
  "data": { "url": "./data/historical_style_transformation.csv" },
  "layer": [
    {
      "mark": { 
        "type": "rect", 
        "stroke": "white", 
        "strokeWidth": 2 
      },
      "encoding": {
        "x": { 
          "field": "Style_Era", 
          "type": "nominal", 
          "axis": { "title": "Style Era", "labelAngle": 30 } 
        },
        "y": { 
          "field": "Artifact_Category", 
          "type": "nominal", 
          "axis": { "title": "Artifact Category" } 
        },
        "color": { 
          "field": "Object_Count", 
          "type": "quantitative", 
          "scale": { "scheme": "viridis" }, 
          "legend": { "title": "Object Count" } 
        },
        "tooltip": [
          { "field": "Style_Era", "type": "nominal" },
          { "field": "Artifact_Category", "type": "nominal" },
          { "field": "Object_Count", "type": "quantitative", "format": "," }
        ]
      }
    },
    {
      "mark": { 
        "type": "text", 
        "fontSize": 12, 
        "fontWeight": "bold" 
      },
      "encoding": {
        "x": { "field": "Style_Era", "type": "nominal" },
        "y": { "field": "Artifact_Category", "type": "nominal" },
        "text": { 
          "field": "Object_Count", 
          "type": "quantitative", 
          "format": ".0f" 
        },
        "color": {
          "condition": {
            "test": "datum.Object_Count > 2500",
            "value": "#202b27"
          },
          "value": "#ffffff"
        }
      }
    }
  ]
}
