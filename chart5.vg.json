{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom 3: Horizontal Bar Chart tracking absolute frequencies across antique sectors.",
  "width": "container",
  "height": 480,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "./data/antiques_master_data.csv"
  },
  "title": {
    "font": "DM Sans, sans-serif",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "#65736d"
  },
  "mark": {
    "type": "bar",
    "color": "#7b2cbf",
    "cornerRadiusTopRight": 4,
    "cornerRadiusBottomRight": 4,
    "cursor": "pointer",
    "tooltip": true
  },
  "encoding": {
    "y": {
      "field": "Category",
      "type": "nominal",
      "title": "Antique Type",
      "sort": "-x",
      "axis": {
        "labelFont": "DM Sans, sans-serif", 
        "titleFont": "DM Sans, sans-serif",
        "titlePadding": 10
      }
    },
    "x": {
      "field": "Object_Count",
      "type": "quantitative",
      "aggregate": "sum",
      "title": "Number of Objects Recorded",
      "axis": {
        "grid": true,
        "gridColor": "#e0e5dd",
        "labelFont": "DM Sans, sans-serif",
        "titleFont": "DM Sans, sans-serif"
      }
    },
    "tooltip": [
      {"field": "Category", "type": "nominal", "title": "Category"},
      {"field": "Object_Count", "type": "quantitative", "aggregate": "sum", "title": "Total Items Tracked", "format": ","}
    ]
  }
}
