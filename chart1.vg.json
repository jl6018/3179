{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Idiom 2: Donut Chart showing the composition of Australia's antique collections with a central total overlay.",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "./data/antiques_master_data.csv"
  },
  "title": {
    "anchor": "start",
    "font": "DM Sans, sans-serif",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "#666666"
  },
  "layer": [
    {
      "description": "Layer 1: Main Donut Ring Slices",
      "mark": {
        "type": "arc", 
        "innerRadius": 90, 
        "outerRadius": 140,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "Object_Count",
          "type": "quantitative",
          "aggregate": "sum"
        },
        "color": {
          "field": "Category",
          "type": "nominal",
          "scale": {
            "domain": ["Furniture", "Ceramics", "Jewellery", "Clocks", "Textiles", "Metalware"],
            "range": ["#1d2d44", "#00b4d8", "#03045e", "#90e0ef", "#0077b6", "#caf0f8"]
          },
          "legend": {
            "orient": "right",
            "title": "Antique Type",
            "labelFont": "DM Sans, sans-serif",
            "titleFont": "DM Sans, sans-serif"
          }
        },
        "tooltip": [
          {"field": "Category", "type": "nominal", "title": "Category"},
          {"field": "Object_Count", "type": "quantitative", "aggregate": "sum", "title": "Total Objects", "format": ","}
        ]
      }
    },
    {
      "description": "Layer 2: Center Total Number Label",
      "transform": [
        {
          "joinaggregate": [{"op": "sum", "field": "Object_Count", "as": "Grand_Total"}]
        }
      ],
      "mark": {
        "type": "text",
        "font": "DM Sans, sans-serif",
        "fontSize": 24,
        "fontWeight": "bold",
        "fill": "#1d2d44",
        "baseline": "middle",
        "align": "center"
      },
      "encoding": {
        "text": {
          "field": "Grand_Total", 
          "type": "quantitative", 
          "aggregate": "min",
          "format": ","
        }
      }
    },
    {
      "description": "Layer 3: Subtext Label under the Total inside center hole",
      "mark": {
        "type": "text",
        "font": "DM Sans, sans-serif",
        "fontSize": 11,
        "fill": "#666666",
        "baseline": "middle",
        "align": "center",
        "dy": 22
      },
      "encoding": {
        "text": {"value": "TOTAL OBJECTS"}
      }
    }
  ]
}
